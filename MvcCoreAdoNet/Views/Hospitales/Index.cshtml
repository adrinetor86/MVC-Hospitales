@{
}
@model List<Hospital>


    <h1>Hospitales Ado Net</h1>

@if (Model != null)
{
    <table class="table table-striped">
        <thead>
            <tr>Nombre</tr>
            <tr>Direccion</tr>
            <tr>Telefono</tr>
        </thead>
        <tbody>

            @foreach (Hospital hospital in Model)
            {
                <tr>
                    <td>@hospital.Nombre</td>
                    <td>@hospital.Direccion</td>
                    <td>@hospital.Telefono</td>
                </tr>
            }
        </tbody>
    </table>
}